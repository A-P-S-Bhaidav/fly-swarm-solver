{
  "name": "FlySwarm Backend",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && pip install --no-cache-dir -r requirements.txt",
  "postStartCommand": "bash scripts/codespace_start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "FlySwarm API",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
